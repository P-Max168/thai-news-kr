+      allow create: if validAdClick(request.resource.data, id)
+        && request.resource.data.n >= 1 && request.resource.data.n <= 20;
+      allow update: if validAdClick(request.resource.data, id)
+        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n'])
+        && request.resource.data.n > resource.data.n && request.resource.data.n <= resource.data.n + 20;
+      allow delete: if false;
+    }
