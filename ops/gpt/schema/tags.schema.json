{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pmaxone.com/schemas/gpt-tags.json",
  "title": "GPT article tags batch",
  "type": "object",
  "required": ["date", "articles"],
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Batch date (Asia/Bangkok calendar day)"
    },
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "tags", "category"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Article id as used on the site (edition-local id ok)"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "maxItems": 20
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "related": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "maxItems": 10,
            "description": "Related article ids"
          }
        }
      }
    }
  }
}
