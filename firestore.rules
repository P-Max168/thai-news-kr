rules_version = '2';
// 태국 뉴스 한눈에 — Firestore 보안 규칙 (Firebase 콘솔 → Firestore Database → 규칙 에 그대로 붙여 넣고 '게시')
//  users/{uid}     : 본인 설정·취향(본인만 읽기/쓰기). lastCommentAt = 댓글 30초 제한용(서버 시각만 허용)
//  profiles/{uid}  : 공개 닉네임 {nickname, isAdmin, updatedAt} (누구나 읽기, 본인만 쓰기)
//  comments/{id}   : 댓글. 숨김 아닌 것만 누구나 읽기 / 로그인한 본인만 작성(30초 1회) / 본인·운영자 삭제 / 운영자 숨김 / 신고 3회면 자동 숨김
//  config/admins   : {uids: [...]} 운영자 목록 — 콘솔에서만 수정(클라이언트 쓰기 금지)
//  rx/{id}         : 익명 반응(하트·🙌·🙅) — 누구나 추가만, 운영자만 읽기(2026-10-03 야간)
//  reports/{id}    : ⚠️ 오류 신고(기사·가게·임대·광고) — 누구나 추가만, 운영자만 읽기, 고치기·지우기 금지(2026-10-05)
//  adclicks/{id}   : 광고 자리별 클릭 수(자리 id + 방콕 날짜 별 숫자만) — 누구나 n 을 1~20 올리기만, 운영자만 읽기(2026-10-05 추가 · ⏳ 아직 게시 전, LOGIN_TODO '대기')
//  placeflags/{id} : 🚫 가게별 폐업 신고 숫자·폐업 확인(숫자만, 원문·사람 정보 없음) — 누구나 읽기, 운영자만 쓰기, 지우기 금지(2026-10-05 추가 · ⏳ 아직 게시 전, LOGIN_TODO '대기')
//  그 밖의 모든 경로 : 거부
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function adminsPath() { return /databases/$(database)/documents/config/admins; }
    function isAdmin() {
      return signedIn() && exists(adminsPath()) && request.auth.uid in get(adminsPath()).data.uids;
    }
    function optType(d, k, t) {
      return !(k in d) || (t == 'string' && d[k] is string) || (t == 'bool' && d[k] is bool)
        || (t == 'number' && d[k] is number) || (t == 'int' && d[k] is int)
        || (t == 'map' && d[k] is map) || (t == 'timestamp' && d[k] is timestamp);
    }

    // ---------- 본인 설정·취향 ----------
    function validTaste(t) {
      return t is map && t.keys().hasOnly(['w', 'votes', 'vf'])
        && (!('w' in t) || (t.w is map && t.w.size() <= 3000))
        && (!('votes' in t) || (t.votes is map && t.votes.size() <= 1500))
        && (!('vf' in t) || (t.vf is map && t.vf.size() <= 1500));
    }
    function validUser(d) {
      return d.keys().hasOnly(['v', 'onboarded', 'persona', 'topics', 'taste', 'updatedAt', 'settingsAt', 'serverAt', 'lastCommentAt'])
        && optType(d, 'v', 'int') && optType(d, 'onboarded', 'bool')
        && (!('persona' in d) || d.persona == null || (d.persona is string && d.persona.size() <= 32))
        && (!('topics' in d) || d.topics == null || (d.topics is list && d.topics.size() <= 10))
        && (!('taste' in d) || validTaste(d.taste))
        && optType(d, 'updatedAt', 'number') && optType(d, 'settingsAt', 'number')
        && optType(d, 'serverAt', 'timestamp') && optType(d, 'lastCommentAt', 'timestamp');
    }
    // lastCommentAt 은 그대로 두거나, 지금 서버 시각(request.time)으로만 바꿀 수 있음(되돌려 제한 피하기 금지)
    function lastCommentOk() {
      let before = resource == null ? null : resource.data.get('lastCommentAt', null);
      let after = request.resource.data.get('lastCommentAt', null);
      return after == before || after == request.time;
    }
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUser(request.resource.data) && lastCommentOk();
      allow delete: if false;
    }

    // ---------- 공개 닉네임 ----------
    function validNick(n) {
      return n is string && n.size() >= 2 && n.size() <= 12
        && !n.matches('(?i).*(운영자|관리자|운영진|admin|official).*');
    }
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['nickname', 'isAdmin', 'updatedAt'])
        && validNick(request.resource.data.nickname)
        && request.resource.data.get('isAdmin', false) == isAdmin()
        && optType(request.resource.data, 'updatedAt', 'timestamp');
      allow delete: if isOwner(uid);
    }

    // ---------- 운영자 목록(콘솔에서만) ----------
    match /config/admins {
      allow read: if true;
      allow write: if false;
    }

    // ---------- 댓글 ----------
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function profilePath(uid) { return /databases/$(database)/documents/profiles/$(uid); }
    // 30초에 1회: 같은 batch 에서 users/{uid}.lastCommentAt 을 지금 시각으로 바꿔야 하고, 이전 값은 30초 이전이어야 함
    function rateOk(uid) {
      return getAfter(userPath(uid)).data.get('lastCommentAt', null) == request.time
        && (!exists(userPath(uid))
            || get(userPath(uid)).data.get('lastCommentAt', null) == null
            || request.time > get(userPath(uid)).data.lastCommentAt + duration.value(30, 's'));
    }
    function validNewComment(d) {
      return d.keys().hasOnly(['articleId', 'edition', 'uid', 'nickname', 'text', 'createdAt', 'isAdmin', 'hidden', 'reports', 'reporters'])
        && d.keys().hasAll(['articleId', 'edition', 'uid', 'nickname', 'text', 'createdAt', 'isAdmin', 'hidden', 'reports', 'reporters'])
        && d.uid == request.auth.uid
        && d.articleId is string && d.articleId.size() >= 1 && d.articleId.size() <= 40
        && d.edition is string && d.edition.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}-(am|pm|early)$')
        && d.text is string && d.text.size() >= 1 && d.text.size() <= 500
        && d.nickname is string && exists(profilePath(request.auth.uid))
        && d.nickname == getAfter(profilePath(request.auth.uid)).data.nickname
        && d.createdAt == request.time
        && d.isAdmin == isAdmin()
        && d.hidden == false && d.reports == 0 && d.reporters == [];
    }
    // 신고: 로그인한 다른 사람이 1번만, reports +1, 3번 이상이면 hidden = true
    function validReport() {
      let r = request.resource.data;
      let o = resource.data;
      return r.diff(o).affectedKeys().hasOnly(['reports', 'reporters', 'hidden'])
        && o.uid != request.auth.uid
        && !(request.auth.uid in o.reporters)
        && r.reporters == o.reporters.concat([request.auth.uid])
        && r.reports == o.reports + 1
        && r.hidden == (o.hidden || r.reports >= 3)
        && r.reporters.size() <= 50;
    }
    match /comments/{id} {
      allow read: if resource.data.hidden == false || isAdmin();
      allow create: if signedIn() && validNewComment(request.resource.data) && rateOk(request.auth.uid);
      allow update: if signedIn() && (
        validReport()
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden']))
      );
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---------- 익명 반응 집계 rx/{id} (2026-10-03 야간 추가) ----------
    // 하트·🙌·🙅 를 운영자 통계용으로 모음. 사람 정보 없음(uid·이름·성별·기기 정보 저장 안 함 — 아래 키 외에는 거부).
    // 누구나 '추가'만(로그인 불필요), 고치기·지우기 금지, 읽기는 운영자만. at 은 서버 시각만.
    // a = "<판 id>/<기사 id>", k = h(하트)|u(더 보여줘)|d(덜 보여줘), v = 1(누름)|-1(취소), r = 사는 곳(추정), i = 관심(추정), tp = 기사 주 주제
    function validRx(d) {
      return d.keys().hasOnly(['a', 'k', 'v', 'r', 'i', 'tp', 'at']) && d.keys().hasAll(['a', 'k', 'v', 'at'])
        && d.a is string && d.a.size() >= 3 && d.a.size() <= 48
        && d.k in ['h', 'u', 'd'] && d.v in [1, -1]
        && (!('r' in d) || d.r in ['east', 'bangkok', 'north', 'south', 'other', 'none'])
        && (!('i' in d) || (d.i is list && d.i.size() <= 4 && d.i.hasOnly(['life', 'travel', 'biz', 'visa'])))
        && (!('tp' in d) || (d.tp is string && d.tp.size() <= 16))
        && d.at == request.time;
    }
    match /rx/{id} {
      allow read: if isAdmin();
      allow create: if validRx(request.resource.data);
      allow update, delete: if false;
    }

    // ---------- ⚠️ 오류 신고 reports/{id} (2026-10-05 추가) ----------
    // 기사·가게·임대·광고의 '오류 신고'. 로그인 불필요, 사람 정보 없음(아래 키 외에는 거부). 누구나 '추가'만, 읽기는 운영자만(승인함 #approve),
    // 고치기·지우기 금지(자동 처리 없음). at 은 서버 시각만. url 은 이 사이트 주소만.
    function validRep(d) {
      return d.keys().hasOnly(['id', 'kind', 'type', 'memo', 'url', 'ed', 'at']) && d.keys().hasAll(['id', 'kind', 'type', 'url', 'at'])
        && d.id is string && d.id.size() >= 1 && d.id.size() <= 80
        && d.kind in ['article', 'place', 'rent', 'ad']
        && d.type in ['wrong', 'link', 'screen', 'etc', 'closed']   // 'closed' = 🚫 폐업·없어짐(2026-10-05 추가 · ⏳ 게시 전)
        && (!('memo' in d) || (d.memo is string && d.memo.size() <= 80))
        && d.url is string && d.url.size() <= 300 && (d.url.matches('^https://p-max168[.]github[.]io/thai-news-kr/.*') || d.url.matches('^https://tnews[.]pmaxone[.]com/.*'))
        && (!('ed' in d) || (d.ed is string && d.ed.size() <= 20))
        && d.at == request.time;
    }
    match /reports/{id} {
      allow read: if isAdmin();
      allow create: if validRep(request.resource.data);
      allow update, delete: if false;
    }

    // ---------- 📊 광고 자리별 클릭 수 adclicks/{자리_날짜} (2026-10-05 추가 · ⏳ 게시 전 — 다음 규칙 게시 때 함께) ----------
    // 사람 정보 없음: 문서 = {s: 광고 자리 id, d: 방콕 날짜 YYYYMMDD(정수), n: 클릭 수} 세 칸만(uid·기기·시각·기사 저장 안 함 — 다른 키는 거부).
    // 문서 id = s + "_" + d. 날짜는 서버 시각 기준 방콕 오늘·어제만(옛 날짜 채우기 금지). 만들 때 n = 1~20, 고칠 때 n 만 1~20 늘리기(줄이기·지우기 금지).
    // 읽기는 운영자만(승인함 통계). 사이트 코드 스위치 assets/social.js AD_CLICK_ON = false(꺼짐)
    function bkDay(t) {
      let b = t + duration.value(7, 'h');
      return b.year() * 10000 + b.month() * 100 + b.day();
    }
    function validAdClick(d, id) {
      return d.keys().hasOnly(['s', 'd', 'n']) && d.keys().hasAll(['s', 'd', 'n'])
        && d.s is string && d.s.matches('^(top|mid|korea-mid|infeed|drawer|footer|nearby-[a-z]{2,12}|region-[a-z]{2,12})$')
        && d.d is int && (d.d == bkDay(request.time) || d.d == bkDay(request.time - duration.value(1, 'd')))
        && id == d.s + '_' + string(d.d)
        && d.n is int;
    }
    match /adclicks/{id} {
      allow read: if isAdmin();
      allow create: if validAdClick(request.resource.data, id)
        && request.resource.data.n >= 1 && request.resource.data.n <= 20;
      allow update: if validAdClick(request.resource.data, id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n'])
        && request.resource.data.n > resource.data.n && request.resource.data.n <= resource.data.n + 20;
      allow delete: if false;
    }

    // ---------- 🚫 가게 폐업 신고 숫자 placeflags/{가게 id} (2026-10-05 추가 · ⏳ 게시 전 — 다음 규칙 게시 때 함께) ----------
    // 신고 원문(reports)은 계속 운영자만 읽음. 운영자 승인함이 가게별 폐업 신고를 세어 숫자만 여기 씀 → 가게 카드 화면이 공개로 읽어 '폐업 신고됨' 표시.
    // 문서 = {id: 가게 id(문서 id 와 같음), n: 신고 수 0~9999, st: '' | 'closed'(운영자 폐업 확인 = 폐업 보관함), at: 서버 시각} — 다른 키 거부. 지우기 금지(기록 남김)
    function validPlaceFlag(d, id) {
      return d.keys().hasOnly(['id', 'n', 'st', 'at']) && d.keys().hasAll(['id', 'n', 'st', 'at'])
        && d.id == id && id.matches('^(osm-(node|way|relation)-[0-9]{1,12}|gmap-[0-9]{1,24})$')
        && d.n is int && d.n >= 0 && d.n <= 9999
        && d.st in ['', 'closed']
        && d.at == request.time;
    }
    match /placeflags/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validPlaceFlag(request.resource.data, id);
      allow delete: if false;
    }

    // ---------- 그 밖에는 모두 거부 ----------
    // ================= 🇨🇳 중국어판(zh.pmaxone.com) 컬렉션 — 2026-10-18 Grok(R-zh-6, 민구님 08:00 승인으로 Claude 대신) · ⏳ 게시 전 =================
    // 같은 Firebase 프로젝트, 판 데이터만 zh_ 접두사(assets/fb.js 가 site 설정 firestore_prefix 로 붙임). users·profiles(계정·닉네임)는 한국판과 공유.
    // 한국판 규칙(위)은 한 글자도 안 바꿈. 게시는 민구님이 Firebase 콘솔에서 직접(LOGIN_TODO). 운영자 목록 = config/admins_zh(콘솔에서만 수정)
    function adminsZhPath() { return /databases/$(database)/documents/config/admins_zh; }
    function isAdminZh() {
      return signedIn() && exists(adminsZhPath()) && request.auth.uid in get(adminsZhPath()).data.uids;
    }
    match /config/admins_zh {
      allow read: if true;
      allow write: if false;
    }
    function validNewCommentZh(d) {
      return d.keys().hasOnly(['articleId', 'edition', 'uid', 'nickname', 'text', 'createdAt', 'isAdmin', 'hidden', 'reports', 'reporters'])
        && d.keys().hasAll(['articleId', 'edition', 'uid', 'nickname', 'text', 'createdAt', 'isAdmin', 'hidden', 'reports', 'reporters'])
        && d.uid == request.auth.uid
        && d.articleId is string && d.articleId.size() >= 1 && d.articleId.size() <= 40
        && d.edition is string && d.edition.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}-(am|md|pm)$')
        && d.text is string && d.text.size() >= 1 && d.text.size() <= 500
        && d.nickname is string && exists(profilePath(request.auth.uid))
        && d.nickname == getAfter(profilePath(request.auth.uid)).data.nickname
        && d.createdAt == request.time
        && d.isAdmin == isAdminZh()
        && d.hidden == false && d.reports == 0 && d.reporters == [];
    }
    match /zh_comments/{id} {
      allow read: if resource.data.hidden == false || isAdminZh();
      allow create: if signedIn() && validNewCommentZh(request.resource.data) && rateOk(request.auth.uid);
      allow update: if signedIn() && (
        validReport()
        || (isAdminZh() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden']))
      );
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdminZh());
    }
    function validRxZh(d) {
      return d.keys().hasOnly(['a', 'k', 'v', 'r', 'i', 'tp', 'at']) && d.keys().hasAll(['a', 'k', 'v', 'at'])
        && d.a is string && d.a.size() >= 3 && d.a.size() <= 48
        && d.k in ['h', 'u', 'd'] && d.v in [1, -1]
        && (!('r' in d) || d.r in ['east', 'bangkok', 'north', 'south', 'other', 'none'])
        && (!('i' in d) || (d.i is list && d.i.size() <= 5 && d.i.hasOnly(['cn', 'visa', 'biz', 'life', 'travel'])))
        && (!('tp' in d) || (d.tp is string && d.tp.size() <= 16))
        && d.at == request.time;
    }
    match /zh_rx/{id} {
      allow read: if isAdminZh();
      allow create: if validRxZh(request.resource.data);
      allow update, delete: if false;
    }
    function validRepZh(d) {
      return d.keys().hasOnly(['id', 'kind', 'type', 'memo', 'url', 'ed', 'at']) && d.keys().hasAll(['id', 'kind', 'type', 'url', 'at'])
        && d.id is string && d.id.size() >= 1 && d.id.size() <= 80
        && d.kind in ['article', 'ad']
        && d.type in ['wrong', 'link', 'screen', 'etc']
        && (!('memo' in d) || (d.memo is string && d.memo.size() <= 80))
        && d.url is string && d.url.size() <= 300 && d.url.matches('^https://zh[.]pmaxone[.]com/.*')
        && (!('ed' in d) || (d.ed is string && d.ed.size() <= 20))
        && d.at == request.time;
    }
    match /zh_reports/{id} {
      allow read: if isAdminZh();
      allow create: if validRepZh(request.resource.data);
      allow update, delete: if false;
    }
    function validAdClickZh(d, id) {
      return d.keys().hasOnly(['s', 'd', 'n']) && d.keys().hasAll(['s', 'd', 'n'])
        && d.s is string && d.s.matches('^(top|mid|china-mid|infeed|drawer|footer)$')
        && d.d is int && (d.d == bkDay(request.time) || d.d == bkDay(request.time - duration.value(1, 'd')))
        && id == d.s + '_' + string(d.d)
        && d.n is int;
    }
    match /zh_adclicks/{id} {
      allow read: if isAdminZh();
      allow create: if validAdClickZh(request.resource.data, id)
        && request.resource.data.n >= 1 && request.resource.data.n <= 20;
      allow update: if validAdClickZh(request.resource.data, id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n'])
        && request.resource.data.n > resource.data.n && request.resource.data.n <= resource.data.n + 20;
      allow delete: if false;
    }

    // ================= 🇻🇳 베트남판(vn.pmaxone.com) 컬렉션 — 2026-10-25 Claude(중국어판 규칙을 그대로 복사, 접두사만 vn_) · ⏳ 게시 전 =================
    // 같은 Firebase 프로젝트, 판 데이터만 vn_ 접두사(assets/fb.js 가 site 설정 firestore_prefix 로 붙임). users·profiles(계정·닉네임)는 한국판과 공유.
    // 한국판 규칙(위)은 한 글자도 안 바꿈. 게시는 민구님이 Firebase 콘솔에서 직접(LOGIN_TODO). 운영자 목록 = config/admins_vn(콘솔에서만 수정)
    function adminsVnPath() { return /databases/$(database)/documents/config/admins_vn; }
    function isAdminVn() {
      return signedIn() && exists(adminsVnPath()) && request.auth.uid in get(adminsVnPath()).data.uids;
    }
    match /config/admins_vn {
      allow read: if true;
      allow write: if false;
    }
    function validNewCommentVn(d) {
      return d.keys().hasOnly(['articleId', 'edition', 'uid', 'nickname', 'text', 'createdAt', 'isAdmin', 'hidden', 'reports', 'reporters'])
        && d.keys().hasAll(['articleId', 'edition', 'uid', 'nickname', 'text', 'createdAt', 'isAdmin', 'hidden', 'reports', 'reporters'])
        && d.uid == request.auth.uid
        && d.articleId is string && d.articleId.size() >= 1 && d.articleId.size() <= 40
        && d.edition is string && d.edition.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}-(am|pm)$')
        && d.text is string && d.text.size() >= 1 && d.text.size() <= 500
        && d.nickname is string && exists(profilePath(request.auth.uid))
        && d.nickname == getAfter(profilePath(request.auth.uid)).data.nickname
        && d.createdAt == request.time
        && d.isAdmin == isAdminVn()
        && d.hidden == false && d.reports == 0 && d.reporters == [];
    }
    match /vn_comments/{id} {
      allow read: if resource.data.hidden == false || isAdminVn();
      allow create: if signedIn() && validNewCommentVn(request.resource.data) && rateOk(request.auth.uid);
      allow update: if signedIn() && (
        validReport()
        || (isAdminVn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden']))
      );
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdminVn());
    }
    function validRxVn(d) {
      return d.keys().hasOnly(['a', 'k', 'v', 'r', 'i', 'tp', 'at']) && d.keys().hasAll(['a', 'k', 'v', 'at'])
        && d.a is string && d.a.size() >= 3 && d.a.size() <= 48
        && d.k in ['h', 'u', 'd'] && d.v in [1, -1]
        && (!('r' in d) || d.r in ['east', 'bangkok', 'north', 'south', 'other', 'none'])
        && (!('i' in d) || (d.i is list && d.i.size() <= 5 && d.i.hasOnly(['kr', 'visa', 'biz', 'life', 'travel'])))
        && (!('tp' in d) || (d.tp is string && d.tp.size() <= 16))
        && d.at == request.time;
    }
    match /vn_rx/{id} {
      allow read: if isAdminVn();
      allow create: if validRxVn(request.resource.data);
      allow update, delete: if false;
    }
    function validRepVn(d) {
      return d.keys().hasOnly(['id', 'kind', 'type', 'memo', 'url', 'ed', 'at']) && d.keys().hasAll(['id', 'kind', 'type', 'url', 'at'])
        && d.id is string && d.id.size() >= 1 && d.id.size() <= 80
        && d.kind in ['article', 'ad']
        && d.type in ['wrong', 'link', 'screen', 'etc']
        && (!('memo' in d) || (d.memo is string && d.memo.size() <= 80))
        && d.url is string && d.url.size() <= 300 && d.url.matches('^https://vn[.]pmaxone[.]com/.*')
        && (!('ed' in d) || (d.ed is string && d.ed.size() <= 20))
        && d.at == request.time;
    }
    match /vn_reports/{id} {
      allow read: if isAdminVn();
      allow create: if validRepVn(request.resource.data);
      allow update, delete: if false;
    }
    function validAdClickVn(d, id) {
      return d.keys().hasOnly(['s', 'd', 'n']) && d.keys().hasAll(['s', 'd', 'n'])
        && d.s is string && d.s.matches('^(top|mid|korea-mid|infeed|drawer|footer)$')
        && d.d is int && (d.d == bkDay(request.time) || d.d == bkDay(request.time - duration.value(1, 'd')))
        && id == d.s + '_' + string(d.d)
        && d.n is int;
    }
    match /vn_adclicks/{id} {
      allow read: if isAdminVn();
      allow create: if validAdClickVn(request.resource.data, id)
        && request.resource.data.n >= 1 && request.resource.data.n <= 20;
      allow update: if validAdClickVn(request.resource.data, id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n'])
        && request.resource.data.n > resource.data.n && request.resource.data.n <= resource.data.n + 20;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
    // ================= 🇰🇷 KSTAR(kstar.pmaxone.com, 태국어) 컬렉션 — 2026-10-25 Claude(베트남판 규칙을 그대로 복사, 접두사만 ks_) · ⏳ 게시 전 =================
    // 같은 Firebase 프로젝트, 판 데이터만 ks_ 접두사(assets/fb.js 가 site 설정 firestore_prefix 로 붙임). users·profiles(계정·닉네임)는 한국판과 공유.
    // 한국판 규칙(위)은 한 글자도 안 바꿈. 게시는 민구님이 Firebase 콘솔에서 직접(LOGIN_TODO). 운영자 목록 = config/admins_ks(콘솔에서만 수정)
    function adminsKsPath() { return /databases/$(database)/documents/config/admins_ks; }
    function isAdminKs() {
      return signedIn() && exists(adminsKsPath()) && request.auth.uid in get(adminsKsPath()).data.uids;
    }
    match /config/admins_ks {
      allow read: if true;
      allow write: if false;
    }
    function validNewCommentKs(d) {
      return d.keys().hasOnly(['articleId', 'edition', 'uid', 'nickname', 'text', 'createdAt', 'isAdmin', 'hidden', 'reports', 'reporters'])
        && d.keys().hasAll(['articleId', 'edition', 'uid', 'nickname', 'text', 'createdAt', 'isAdmin', 'hidden', 'reports', 'reporters'])
        && d.uid == request.auth.uid
        && d.articleId is string && d.articleId.size() >= 1 && d.articleId.size() <= 40
        && d.edition is string && d.edition.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}-(am|md|pm)$')
        && d.text is string && d.text.size() >= 1 && d.text.size() <= 500
        && d.nickname is string && exists(profilePath(request.auth.uid))
        && d.nickname == getAfter(profilePath(request.auth.uid)).data.nickname
        && d.createdAt == request.time
        && d.isAdmin == isAdminKs()
        && d.hidden == false && d.reports == 0 && d.reporters == [];
    }
    match /ks_comments/{id} {
      allow read: if resource.data.hidden == false || isAdminKs();
      allow create: if signedIn() && validNewCommentKs(request.resource.data) && rateOk(request.auth.uid);
      allow update: if signedIn() && (
        validReport()
        || (isAdminKs() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden']))
      );
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdminKs());
    }
    function validRxKs(d) {
      return d.keys().hasOnly(['a', 'k', 'v', 'r', 'i', 'tp', 'at']) && d.keys().hasAll(['a', 'k', 'v', 'at'])
        && d.a is string && d.a.size() >= 3 && d.a.size() <= 48
        && d.k in ['h', 'u', 'd'] && d.v in [1, -1]
        && (!('r' in d) || d.r in ['east', 'bangkok', 'north', 'south', 'other', 'none'])
        && (!('i' in d) || (d.i is list && d.i.size() <= 5 && d.i.hasOnly(['kr', 'visa', 'biz', 'life', 'travel'])))
        && (!('tp' in d) || (d.tp is string && d.tp.size() <= 16))
        && d.at == request.time;
    }
    match /ks_rx/{id} {
      allow read: if isAdminKs();
      allow create: if validRxKs(request.resource.data);
      allow update, delete: if false;
    }
    function validRepKs(d) {
      return d.keys().hasOnly(['id', 'kind', 'type', 'memo', 'url', 'ed', 'at']) && d.keys().hasAll(['id', 'kind', 'type', 'url', 'at'])
        && d.id is string && d.id.size() >= 1 && d.id.size() <= 80
        && d.kind in ['article', 'ad']
        && d.type in ['wrong', 'link', 'screen', 'etc']
        && (!('memo' in d) || (d.memo is string && d.memo.size() <= 80))
        && d.url is string && d.url.size() <= 300 && d.url.matches('^https://kstar[.]pmaxone[.]com/.*')
        && (!('ed' in d) || (d.ed is string && d.ed.size() <= 20))
        && d.at == request.time;
    }
    match /ks_reports/{id} {
      allow read: if isAdminKs();
      allow create: if validRepKs(request.resource.data);
      allow update, delete: if false;
    }
    function validAdClickKs(d, id) {
      return d.keys().hasOnly(['s', 'd', 'n']) && d.keys().hasAll(['s', 'd', 'n'])
        && d.s is string && d.s.matches('^(top|mid|korea-mid|infeed|drawer|footer)$')
        && d.d is int && (d.d == bkDay(request.time) || d.d == bkDay(request.time - duration.value(1, 'd')))
        && id == d.s + '_' + string(d.d)
        && d.n is int;
    }
    match /ks_adclicks/{id} {
      allow read: if isAdminKs();
      allow create: if validAdClickKs(request.resource.data, id)
        && request.resource.data.n >= 1 && request.resource.data.n <= 20;
      allow update: if validAdClickKs(request.resource.data, id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n'])
        && request.resource.data.n > resource.data.n && request.resource.data.n <= resource.data.n + 20;
      allow delete: if false;
    }

    // ================= 🧑‍💼 KSTAR 구인·구직 게시판(2026-10-25 Claude · ⏳ 게시 전) — 화면 assets/board-jobs.js(판 설정 board.jobs) =================
    // ks_resumes/{uid}        : 구직 글(회원 1명당 1개, 문서 id = 내 uid). 로그인 회원만 읽기(게시 중·기간 안), 본인 쓰기·지우기, 30일(exp) 뒤 숨김
    // ks_resume_contacts/{uid}: LINE ID(본인이 고를 때만) — 본인·운영자·승인된 회사만 읽기
    // ks_employers/{uid}      : 회사 확인 신청 — 본인·운영자만 읽기. 만들 때 st='pending' 만, st 를 'ok'/'no' 로 바꾸는 건 운영자만(= 공고 쓰기 허가)
    // ks_jobs/{id}            : 구인 공고 — 누구나 읽기(게시 중·마감 전), 승인된 회사만 만들기. 금지 낱말이 있으면 vis='pending'(운영자 확인)만 허용
    // 신고: 로그인한 다른 사람이 글마다 1번, 3번이면 vis='reported'(숨김). 운영자 = config/admins_ks. 한국판·다른 판 규칙은 그대로
    function ksEmpPath(uid) { return /databases/$(database)/documents/ks_employers/$(uid); }
    function ksEmpOk() { return signedIn() && exists(ksEmpPath(request.auth.uid)) && get(ksEmpPath(request.auth.uid)).data.st == 'ok'; }
    function ksKinds() { return ['interp', 'tour', 'beauty', 'office', 'content', 'other']; }
    function ksKo() { return ['none', 'daily', 't1', 't2', 't3', 't4', 't5', 't6']; }
    function ksProv() { return ['bangkok', 'amnatcharoen', 'angthong', 'buengkan', 'buriram', 'chachoengsao', 'chainat', 'chaiyaphum', 'chanthaburi', 'chiangmai', 'chiangrai', 'chonburi', 'chumphon', 'kalasin', 'kamphaengphet', 'kanchanaburi', 'khonkaen', 'krabi', 'lampang', 'lamphun', 'loei', 'lopburi', 'maehongson', 'mahasarakham', 'mukdahan', 'nakhonnayok', 'nakhonpathom', 'nakhonphanom', 'nakhonratchasima', 'nakhonsawan', 'nakhonsithammarat', 'nan', 'narathiwat', 'nongbualamphu', 'nongkhai', 'nonthaburi', 'pathumthani', 'pattani', 'phangnga', 'phatthalung', 'phayao', 'phetchabun', 'phetchaburi', 'phichit', 'phitsanulok', 'ayutthaya', 'phrae', 'phuket', 'prachinburi', 'prachuapkhirikhan', 'ranong', 'ratchaburi', 'rayong', 'roiet', 'sakaeo', 'sakonnakhon', 'samutprakan', 'samutsakhon', 'samutsongkhram', 'saraburi', 'satun', 'singburi', 'sisaket', 'songkhla', 'sukhothai', 'suphanburi', 'suratthani', 'surin', 'tak', 'trang', 'trat', 'ubonratchathani', 'udonthani', 'uthaithani', 'uttaradit', 'yala', 'yasothon']; }
    // 금지 낱말 — assets/board-jobs.js 의 BANNED 와 같은 목록(바꾸면 두 곳 같이)
    function ksBanned(t) { return t.lower().matches('(?s).*(ไปทำงาน.{0,12}(เกาหลี|ต่างประเทศ|ญี่ปุ่น|ไต้หวัน|ดูไบ|ยุโรป|อเมริกา|ออสเตรเลีย)|ทำงาน(ที่|ใน)?(ประเทศ)?เกาหลี|ทำงานต่างประเทศ|แรงงานเกาหลี|ผีน้อย|บินไปทำงาน|work(ing)? (in|at) korea|work abroad|overseas (job|work)|korea(n)? (work )?visa|\\be-?9\\b|한국\\s*(현지\\s*)?(근무|취업)|한국에서\\s*(근무|일)|해외\\s*(취업|근무)|불법\\s*체류|รายได้สูง|รายได้ดีมาก|รายได้หลักแสน|งานง่าย.{0,6}รายได้|high income|easy money|고수입|고소득|นวด|อาบอบนวด|คาราโอเกะ|บาร์|ผับ|โฮสต์|ไซด์ไลน์|นั่งดริงค์|นั่งดริ้ง|งานเอ็น|เด็กเอ็น|เอ็นเตอร์เทนลูกค้า|พริตตี้|เซ็กซี่|massage|karaoke|\\bbar\\b|\\bpub\\b|\\bhost(ess)?\\b|escort|sideline|night ?life|sexy|마사지|유흥|노래방|가라오케|에스코트|도우미|룸살롱|ทำวีซ่า|จัดหาวีซ่า|รับทำวีซ่า|ดำเนินการวีซ่า|visa (service|agent|arrang)|비자\\s*(대행|발급)|ค่าสมัคร|ค่าดำเนินการ|ค่าเอกสาร|มัดจำ|ค่าหัว|ค่านายหน้า|เงินประกัน|โอนเงินก่อน|โอนค่า|deposit|\\bfee\\b|보증금|수수료|선입금).*'); }
    function ksStr(d, k, lo, hi) { return d[k] is string && d[k].size() >= lo && d[k].size() <= hi; }
    function ksBoardReport() {
      let r = request.resource.data;
      let o = resource.data;
      return r.diff(o).affectedKeys().hasOnly(['reports', 'reporters', 'vis'])
        && o.uid != request.auth.uid && !(request.auth.uid in o.reporters)
        && r.reporters == o.reporters.concat([request.auth.uid]) && r.reports == o.reports + 1
        && r.vis == (r.reports >= 3 ? 'reported' : o.vis) && r.reporters.size() <= 50;
    }
    function validResumeKs(d, uid) {
      return d.keys().hasOnly(['uid', 'nick', 'job', 'area', 'ko', 'sum', 'from', 'contact', 'adult', 'vis', 'at', 'exp', 'reports', 'reporters'])
        && d.keys().hasAll(['uid', 'nick', 'job', 'area', 'ko', 'sum', 'from', 'contact', 'adult', 'vis', 'at', 'exp', 'reports', 'reporters'])
        && d.uid == uid && ksStr(d, 'nick', 2, 20) && !d.nick.matches('(?i).*(admin|official|운영자|관리자|ผู้ดูแล).*')
        && d.job in ksKinds() && (d.area in ksProv() || d.area == 'online') && d.ko in ksKo()
        && ksStr(d, 'sum', 10, 300) && !ksBanned(d.nick + ' ' + d.sum)
        && !d.sum.replace('[ .()+-]', '').matches('(?s).*[0-9]{9,}.*')
        && d.from is string && d.from.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && d.contact in ['none', 'line'] && d.adult == true
        && d.at == request.time && d.exp is timestamp && d.exp > request.time && d.exp <= request.time + duration.value(31, 'd')
        && d.reporters is list;
    }
    match /ks_resumes/{uid} {
      allow get: if (signedIn() && resource.data.vis == 'open' && resource.data.exp > request.time) || isOwner(uid) || isAdminKs();
      allow list: if (signedIn() && resource.data.vis == 'open') || (signedIn() && resource.data.uid == request.auth.uid) || isAdminKs();
      allow create: if isOwner(uid) && validResumeKs(request.resource.data, uid)
        && request.resource.data.vis == 'open' && request.resource.data.reports == 0 && request.resource.data.reporters == [];
      allow update: if signedIn() && (
        (isOwner(uid) && validResumeKs(request.resource.data, uid)
          && resource.data.vis in ['open', 'hidden'] && request.resource.data.vis in ['open', 'hidden']
          && request.resource.data.reports == resource.data.reports && request.resource.data.reporters == resource.data.reporters)
        || ksBoardReport()
        || (isAdminKs() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vis']) && request.resource.data.vis in ['open', 'hidden'])
      );
      allow delete: if isOwner(uid) || isAdminKs();
    }
    match /ks_resume_contacts/{uid} {
      allow get: if isOwner(uid) || isAdminKs() || ksEmpOk();
      allow list: if isAdminKs();
      allow create, update: if isOwner(uid) && request.resource.data.keys().hasOnly(['line', 'at']) && request.resource.data.keys().hasAll(['line', 'at'])
        && request.resource.data.line is string && request.resource.data.line.matches('^@?[A-Za-z0-9._-]{2,40}$')
        && request.resource.data.at == request.time;
      allow delete: if isOwner(uid) || isAdminKs();
    }
    function validEmpKs(d, uid) {
      return d.keys().hasOnly(['uid', 'name', 'dbd', 'person', 'contact', 'prov', 'web', 'st', 'at', 'note'])
        && d.keys().hasAll(['uid', 'name', 'dbd', 'person', 'contact', 'prov', 'st', 'at'])
        && d.uid == uid && ksStr(d, 'name', 2, 80) && d.dbd is string && d.dbd.matches('^0[0-9]{12}$')
        && ksStr(d, 'person', 2, 40) && ksStr(d, 'contact', 3, 80) && d.prov in ksProv()
        && (!('web' in d) || d.web == '' || (d.web is string && d.web.size() <= 120 && d.web.matches('^https?://[^ ]+$')))
        && (!('note' in d) || (d.note is string && d.note.size() <= 120));
    }
    match /ks_employers/{uid} {
      allow get: if isOwner(uid) || isAdminKs();
      allow list: if isAdminKs();
      allow create: if isOwner(uid) && validEmpKs(request.resource.data, uid) && request.resource.data.st == 'pending'
        && request.resource.data.at == request.time && !('note' in request.resource.data);
      allow update: if (isOwner(uid) && resource.data.st in ['pending', 'no'] && validEmpKs(request.resource.data, uid)
          && request.resource.data.st == 'pending' && request.resource.data.at == request.time
          && request.resource.data.get('note', '') == resource.data.get('note', ''))
        || (isAdminKs() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'note'])
          && request.resource.data.st in ['pending', 'ok', 'no']
          && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 120);
      allow delete: if isOwner(uid) || isAdminKs();
    }
    function validJobKs(d) {
      return d.keys().hasOnly(['uid', 'co', 'title', 'job', 'prov', 'type', 'pay', 'smin', 'smax', 'ko', 'desc', 'apply', 'dl', 'vis', 'at', 'exp', 'reports', 'reporters'])
        && d.keys().hasAll(['uid', 'co', 'title', 'job', 'prov', 'type', 'pay', 'smin', 'smax', 'ko', 'desc', 'apply', 'dl', 'vis', 'at', 'exp', 'reports', 'reporters'])
        && d.uid == request.auth.uid && d.co == get(ksEmpPath(request.auth.uid)).data.name
        && ksStr(d, 'title', 4, 80) && d.job in ksKinds() && d.prov in ksProv()
        && d.type in ['full', 'part', 'contract', 'freelance', 'intern'] && d.pay in ['month', 'day', 'hour']
        && d.smin is int && d.smax is int && d.smin >= 1 && d.smin <= d.smax && d.smax <= 1000000
        && d.ko in ksKo() && ksStr(d, 'desc', 10, 800) && ksStr(d, 'apply', 3, 200)
        && d.dl is timestamp && d.dl > request.time && d.dl <= request.time + duration.value(61, 'd') && d.exp == d.dl
        && d.at == request.time && d.reports == 0 && d.reporters == []
        && (d.vis == 'pending' || (d.vis == 'open' && !ksBanned(d.title + ' ' + d.desc + ' ' + d.apply)));
    }
    match /ks_jobs/{id} {
      allow get: if (resource.data.vis == 'open' && resource.data.exp > request.time) || (signedIn() && resource.data.uid == request.auth.uid) || isAdminKs();
      allow list: if resource.data.vis == 'open' || (signedIn() && resource.data.uid == request.auth.uid) || isAdminKs();
      allow create: if ksEmpOk() && validJobKs(request.resource.data);
      allow update: if signedIn() && (
        ksBoardReport()
        || (resource.data.uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vis'])
          && resource.data.vis in ['open', 'hidden'] && request.resource.data.vis in ['open', 'hidden'])
        || (isAdminKs() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vis']) && request.resource.data.vis in ['open', 'hidden', 'no'])
      );
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdminKs());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
